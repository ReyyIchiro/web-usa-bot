# ============================================================
# USA Core Website — Environment Variables Template
#
# CARA PENGGUNAAN:
# 1. Salin file ini ke .env.local:
#    cp .env.example .env.local
# 2. Isi nilai variabel di .env.local sesuai project Anda.
# 3. JANGAN PERNAH commit file .env.local ke Git repository!
# ============================================================

# ── Supabase (Wajib) ─────────────────────────────────────────
# Dapatkan kredensial dari:
# Supabase Dashboard → Project Settings → API

# URL Project Supabase Anda
# Format contoh: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (Aman untuk browser / client-side)
# PERINGATAN: Gunakan anon / public key, JANGAN gunakan service_role key!
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
